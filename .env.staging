# 页面标题
VITE_APP_TITLE = 若依管理系统

# 预发布环境配置
VITE_APP_ENV = 'staging'

# 若依管理系统/预发布环境
VITE_APP_BASE_API = '/stage-api'

# 智能体服务地址
VITE_APP_AGENT_API = 'http://localhost:8090'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip


#Electron 在线更新配置（占位符，部署时替换为实际地址）

PTMJ_UPDATE_PROVIDER=generic
PTMJ_UPDATE_URL=https://example.com/auto-updates
