# 页面标题
VITE_APP_TITLE = PezMax

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境 (用于代理前缀)
VITE_APP_BASE_API = '/dev-api'

# Electron 主进程直连后端的真实目标地址（请根据您的后端实际地址进行修改）
VITE_APP_TARGET_URL = 'http://localhost:8080'

# Electron 在线更新配置（占位符，部署时替换为实际地址）
PTMJ_UPDATE_PROVIDER=generic
PTMJ_UPDATE_URL=https://example.com/auto-updates
# GitHub 发布方式（备选）
# PTMJ_UPDATE_PROVIDER=github
# PTMJ_UPDATE_GH_OWNER=your-owner
# PTMJ_UPDATE_GH_REPO=your-repo
