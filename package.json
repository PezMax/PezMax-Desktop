{
  "name": "PezMax",
  "version": "1.0.0",
  "description": "An Electron application with Vue",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "set VITE_AUTH_ENTRY_MODE=client&& electron-vite dev",
    "dev:client": "set VITE_AUTH_ENTRY_MODE=client&& electron-vite dev",
    "dev:admin": "set VITE_AUTH_ENTRY_MODE=admin&& electron-vite dev",
    "build": "electron-vite build",
    "clean": "powershell -Command \"if (Test-Path out) { Remove-Item -Recurse -Force out }; if (Test-Path dist) { Remove-Item -Recurse -Force dist }\"",
    "build:client": "npm run clean && set VITE_AUTH_ENTRY_MODE=client&& electron-vite build",
    "build:admin": "npm run clean && set VITE_AUTH_ENTRY_MODE=admin&& electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run clean && npm run build && electron-builder --dir",
    "build:win": "npm run clean && npm run build && electron-builder --win",
    "build:mac": "npm run clean && npm run build && electron-builder --mac",
    "build:linux": "npm run clean && npm run build && electron-builder --linux",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.2",
    "clipboard": "^2.0.11",
    "echarts": "^6.0.0",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.13.6",
    "file-saver": "2.0.5",
    "form-data": "^4.0.5",
    "fuse.js": "^7.3.0",
    "js-beautify": "^1.15.4",
    "js-cookie": "^3.0.5",
    "jsencrypt": "^3.5.4",
    "marked": "^18.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "splitpanes": "^4.0.4",
    "vue-cropper": "^0.6.5",
    "vue-router": "4.6.4",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "less": "^4.6.4",
    "prettier": "^3.7.4",
    "sass": "^1.98.0",
    "sass-embedded": "^1.99.0",
    "stylus": "^0.64.0",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-setup-extend-plus": "^1.0.1",
    "vite": "^7.2.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitepress": "^1.6.4",
    "vue": "3.5.26",
    "vue-eslint-parser": "^10.2.0"
  }
}
