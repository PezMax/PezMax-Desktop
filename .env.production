# 页面标题
VITE_APP_TITLE = PezMax

# 生产环境配置
VITE_APP_ENV = 'production'

# 若依管理系统/生产环境
VITE_APP_BASE_API = 'http://localhost:8080'

# Electron 主进程直连后端的真实目标地址
VITE_APP_TARGET_URL = 'http://localhost:8080'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# Electron 在线更新配置（占位符，部署时替换为实际地址）

PTMJ_UPDATE_PROVIDER=generic
PTMJ_UPDATE_URL=https://example.com/auto-updates