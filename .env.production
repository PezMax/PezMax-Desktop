# 页面标题
VITE_APP_TITLE = PezMax

# 生产环境配置
VITE_APP_ENV = 'production'

# 若依管理系统/生产环境
VITE_APP_BASE_API = 'http://154.8.139.48:8080'

# Electron 主进程直连后端的真实目标地址
VITE_APP_TARGET_URL = 'http://154.8.139.48:8080'

# 智能体服务地址
VITE_APP_AGENT_API = 'http://localhost:8090'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# Electron 在线更新配置（GH代理访问 GitHub Releases 最新版本）
# electron-updater generic 模式会从该 URL 拉取 latest.yml 和 .blockmap 差分文件
PTMJ_UPDATE_PROVIDER=generic
PTMJ_UPDATE_URL=https://gh-proxy.com/https://github.com/Torchman005/PezMax-Desktop/releases/latest/download
